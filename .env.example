# ─── Database ────────────────────────────────────────────────
# Replace <db_username> and <db_password> with your MongoDB Atlas credentials.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.zyyhzcl.mongodb.net/nivorea?retryWrites=true&w=majority&appName=Cluster0

# ─── Auth ────────────────────────────────────────────────────
# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# First admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@nivorea.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Nivorea Admin

# ─── Public site URL (used in emails & SEO) ──────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (invoices) — Gmail: use an App Password ───────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nivorea Apparels <your@gmail.com>"
# Where new-order notifications go (optional)
ADMIN_NOTIFY_EMAIL=

# ─── Image uploads (free) — Cloudinary ───────────────────────
# Cloudinary Dashboard → "API Environment variable". Replace the key & secret.
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@dbey77goh
